# Railpack renders this in place of its default Caddyfile ({{.DIST_DIR}} is /app/dist).
# Same as the default, plus cache headers and the precompressed files the build writes.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Vite's hashed output never changes under the same name.
	@hashed path /build/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Everything else keeps its name across deploys: revalidate with the ETag every time.
	# Repeat visits skip even that through the service worker (src/sw).
	@named not path /build/*
	header @named Cache-Control "no-cache"

	root * {{.DIST_DIR}}

	file_server {
		hide .git
		hide .env*
		# The build writes .br and .gz next to every compressible file (scripts/build-assets.ts).
		precompressed br gzip
	}

	encode {
		zstd
		gzip
	}

	try_files {path} {path}.html {path}/index.html
}
